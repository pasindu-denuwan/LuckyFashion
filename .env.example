# Lucky Fashion Environment Variables
# Copy to .env.local for local development. NEVER commit real secret keys.

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (Service Role - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (Anti-Spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend Email Service (Optional: off until configured)
RESEND_API_KEY=re_placeholder_key_here
RESEND_FROM_EMAIL=quotes@luckyfashion.com
ADMIN_ALERT_EMAIL=admin@luckyfashion.com

# On-Demand Revalidation Secret
REVALIDATION_SECRET=change_me_to_a_secure_random_string

